[Unit]
Description=웨딩홀 빈자리 감시 (삼성카드 결혼도움방)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 아래 두 줄을 실제 경로/사용자로 바꾸세요.
User=pi
WorkingDirectory=/home/pi/wedding-watch
ExecStart=/home/pi/wedding-watch/.venv/bin/wedding-watch run
Restart=always
RestartSec=60
# 로그인 쿠키와 상태 파일만 쓰면 되므로 나머지는 읽기 전용으로 둔다.
ProtectSystem=strict
ReadWritePaths=/home/pi/wedding-watch/state
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
